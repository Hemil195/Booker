{
  "manifest_version": 3,
  "name": "Bookar Sync",
  "version": "1.1.0",
  "description": "Sync your bookmarks to Bookar — AI-powered, searchable, accessible to your AI assistants.",
  "permissions": ["bookmarks", "history", "storage", "activeTab", "alarms"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vercel.app/*",
    "https://bookar.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookar Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
